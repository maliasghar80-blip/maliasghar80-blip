{%- liquid
  assign p = section.settings.product
  if p == blank
    assign p = all_products['fundable-numbers']
  endif
  assign v = p.selected_or_first_available_variant
  assign code = section.settings.discount_code | strip
  if code != blank
    assign buy_url = '/cart/' | append: v.id | append: ':1?discount=' | append: code
  else
    assign buy_url = '/cart/' | append: v.id | append: ':1'
  endif
  assign pct = section.settings.discount_percent
  assign keep = 100 | minus: pct
  assign launch_cents = v.price | times: keep | divided: 100
-%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  {%- if section.settings.hide_theme_chrome -%}
  #header-group, body > .page-wrapper > footer { display:none !important; }
  {%- endif -%}
  .fn{ --ink:#0E1A2B; --ink2:#3A4658; --mut:#6B7686; --paper:#FBF8F2; --line:#E6E0D4; --g:#16794A; --gl:#7FD6A6; --gs:#E3F2E9; --am:#E9A23B; --ams:#FCF0DC; --r:#C2412D; --rs:#FBE6E1;
       font-family:Inter,system-ui,sans-serif; color:var(--ink); background:var(--paper); line-height:1.55; -webkit-font-smoothing:antialiased }
  .fn *{ box-sizing:border-box }
  .fn h1,.fn h2,.fn h3{ font-family:Fraunces,Georgia,serif; letter-spacing:-.015em; margin:0; color:inherit }
  .fn p{ margin:0 0 1em }
  .fn a{ color:inherit }
  .fn .wrap{ max-width:1120px; margin:0 auto; padding:0 24px }
  .fn .k{ font-size:12px; font-weight:700; letter-spacing:.16em; text-transform:uppercase; color:var(--g); margin-bottom:14px }
  .fn .dark{ background:var(--ink); color:#fff } .fn .dark .k{ color:var(--gl) } .fn .dark p{ color:#C9D3E0 }
  .fn .btn{ display:inline-flex; align-items:center; gap:10px; background:var(--gl); color:var(--ink); font-weight:800; font-size:17px; padding:17px 28px; border-radius:999px; text-decoration:none; transition:transform .15s, box-shadow .15s; box-shadow:0 10px 30px rgba(127,214,166,.25) }
  .fn .btn:hover{ transform:translateY(-2px); box-shadow:0 16px 40px rgba(127,214,166,.35) }
  .fn .btn.dk{ background:var(--ink); color:#fff; box-shadow:0 10px 30px rgba(14,26,43,.2) }
  .fn .ghost{ color:#C9D3E0; font-weight:600; text-decoration:underline; text-underline-offset:4px }
  /* bar */
  .fn .bar{ background:var(--am); color:var(--ink); text-align:center; font-weight:700; font-size:14px; padding:10px 16px }
  .fn .bar code{ background:var(--ink); color:var(--gl); padding:2px 8px; border-radius:6px; font-family:inherit }
  .fn .nav{ display:flex; justify-content:space-between; align-items:center; padding:22px 0 }
  .fn .brand{ font-family:Fraunces,serif; font-weight:800; font-size:22px; text-decoration:none }
  .fn .brand span{ color:var(--gl) }
  .fn .nav a.small{ font-weight:700; font-size:14px; text-decoration:none; border:1px solid #3A4A62; padding:9px 16px; border-radius:999px }
  /* hero */
  .fn .hero{ display:grid; grid-template-columns:1.05fr .95fr; gap:48px; align-items:center; padding:40px 0 90px }
  .fn .hero h1{ font-size:clamp(46px,7vw,84px); line-height:.98; font-weight:800 }
  .fn .hero h1 span{ color:var(--gl) }
  .fn .hero .sub{ font-size:21px; color:#C9D3E0; margin:22px 0 30px; max-width:520px }
  .fn .price{ display:flex; align-items:baseline; gap:12px; margin-bottom:22px }
  .fn .price .now{ font-family:Fraunces,serif; font-weight:800; font-size:40px; color:#fff }
  .fn .price s{ color:#7F8DA3; font-size:20px }
  .fn .price .tag{ background:var(--gs); color:var(--g); font-weight:800; font-size:12px; padding:5px 10px; border-radius:999px; letter-spacing:.06em }
  .fn .ctas{ display:flex; gap:22px; align-items:center; flex-wrap:wrap }
  .fn .trust{ display:flex; gap:22px; flex-wrap:wrap; margin-top:28px; font-size:14px; color:#9FB0C6 }
  .fn .trust span::before{ content:"✓ "; color:var(--gl); font-weight:800 }
  .fn .hero img{ width:100%; height:auto; border-radius:18px; box-shadow:0 40px 90px rgba(0,0,0,.45) }
  .fn .count{ display:flex; gap:10px; margin:0 0 24px }
  .fn .count div{ background:#16263C; border:1px solid #2A3D58; border-radius:12px; padding:8px 12px; text-align:center; min-width:62px }
  .fn .count b{ display:block; font-size:22px; font-variant-numeric:tabular-nums } .fn .count small{ color:#9FB0C6; font-size:11px; text-transform:uppercase; letter-spacing:.1em }
  /* sections */
  .fn section.s{ padding:96px 0 }
  .fn h2{ font-size:clamp(32px,4.4vw,52px); line-height:1.05; font-weight:800; margin-bottom:18px }
  .fn .lead{ font-size:19px; color:var(--ink2); max-width:720px }
  .fn .g3{ display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-top:40px }
  .fn .g2{ display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-top:40px }
  .fn .card{ background:#fff; border:1px solid var(--line); border-radius:20px; padding:28px }
  .fn .card h3{ font-size:22px; margin-bottom:8px }
  .fn .card p{ color:var(--ink2); margin:0 }
  .fn .card .ic{ width:44px; height:44px; border-radius:12px; display:grid; place-items:center; font-weight:800; margin-bottom:16px }
  .fn .red .ic{ background:var(--rs); color:var(--r) }
  .fn .ch{ display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-top:40px }
  .fn .ch .card{ padding:22px }
  .fn .ch .n{ font-family:Fraunces,serif; font-weight:800; font-size:34px; color:var(--g); line-height:1; margin-bottom:10px }
  .fn .ch h3{ font-size:18px; line-height:1.25 }
  .fn .ch p{ font-size:14px; margin-top:6px }
  .fn .tools{ display:flex; flex-wrap:wrap; gap:10px; margin-top:24px }
  .fn .tools span{ background:var(--gs); color:var(--g); font-weight:700; font-size:14px; padding:8px 14px; border-radius:999px }
  .fn .shots{ display:grid; grid-template-columns:repeat(4,1fr); gap:18px; margin-top:44px }
  .fn .shots img{ width:100%; height:auto; border-radius:10px; box-shadow:0 18px 40px rgba(14,26,43,.18); background:#fff; transition:transform .2s }
  .fn .shots img:hover{ transform:translateY(-6px) rotate(-1deg) }
  .fn table{ width:100%; border-collapse:collapse; background:#fff; border-radius:16px; overflow:hidden; font-size:15px; margin-top:32px }
  .fn th{ text-align:left; background:var(--ink); color:#fff; padding:12px 16px; font-size:13px; letter-spacing:.04em }
  .fn td{ padding:12px 16px; border-bottom:1px solid var(--line); color:var(--ink2) }
  .fn td.n{ text-align:right; font-variant-numeric:tabular-nums } .fn tr.t td{ background:var(--gs); color:var(--ink); font-weight:800 }
  .fn .vs{ display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-top:40px }
  .fn .vs .card.bad{ background:var(--rs); border-color:transparent } .fn .vs .card.good{ background:var(--gs); border-color:transparent }
  .fn .pill{ display:inline-block; font-size:12px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; margin-bottom:12px }
  .fn ul.ck{ list-style:none; padding:0; margin:0 } .fn ul.ck li{ padding:10px 0 10px 30px; position:relative; border-bottom:1px solid rgba(0,0,0,.06) }
  .fn ul.ck li::before{ content:"✓"; position:absolute; left:0; color:var(--g); font-weight:800 }
  .fn ul.x li::before{ content:"✕"; color:var(--r) }
  .fn .author{ display:grid; grid-template-columns:auto 1fr; gap:28px; align-items:center }
  .fn .avatar{ width:96px; height:96px; border-radius:50%; background:var(--gl); color:var(--ink); display:grid; place-items:center; font-family:Fraunces,serif; font-weight:800; font-size:36px }
  .fn details{ background:#fff; border:1px solid var(--line); border-radius:16px; padding:20px 24px; margin-bottom:12px }
  .fn summary{ font-weight:700; font-size:17px; cursor:pointer; list-style:none; display:flex; justify-content:space-between }
  .fn summary::after{ content:"+"; color:var(--g); font-size:22px; line-height:1 } .fn details[open] summary::after{ content:"–" }
  .fn details p{ margin:12px 0 0; color:var(--ink2) }
  .fn .final{ text-align:center } .fn .final h2{ color:#fff } .fn .final .price{ justify-content:center }
  .fn .foot{ border-top:1px solid #22344D; padding:28px 0; font-size:13px; color:#7F8DA3; display:flex; justify-content:space-between; gap:16px; flex-wrap:wrap }
  .fn .foot a{ color:#9FB0C6; margin-right:16px; text-decoration:none }
  .fn .sticky{ position:fixed; left:0; right:0; bottom:0; z-index:50; background:rgba(14,26,43,.96); backdrop-filter:blur(8px); padding:12px 16px; display:none; align-items:center; justify-content:space-between; gap:12px; color:#fff; border-top:1px solid #2A3D58 }
  .fn .sticky.on{ display:flex } .fn .sticky .btn{ padding:12px 20px; font-size:15px }
  @media (max-width: 900px){
    .fn .hero{ grid-template-columns:1fr; padding:20px 0 70px } .fn .hero .media{ order:-1 }
    .fn .g3,.fn .g2,.fn .vs{ grid-template-columns:1fr } .fn .ch{ grid-template-columns:1fr 1fr } .fn .shots{ grid-template-columns:1fr 1fr }
    .fn section.s{ padding:68px 0 } .fn .author{ grid-template-columns:1fr }
  }
</style>

<div class="fn">
  {%- if code != blank -%}
  <div class="bar">Launch week: use code <code>{{ code }}</code> for {{ pct }}% off. It's applied automatically when you click buy.</div>
  {%- endif -%}

  <div class="dark">
    <div class="wrap">
      {%- if section.settings.hide_theme_chrome -%}
      <div class="nav"><a class="brand" href="/">Fundable <span>Numbers.</span></a><a class="small" href="{{ buy_url }}">Get the guide</a></div>
      {%- endif -%}
      {%- if section.settings.show_hero -%}
      <div class="hero">
        <div>
          <div class="k">A weekend guide for founders who are raising</div>
          <h1>Fundable<br><span>Numbers.</span></h1>
          <p class="sub">Build a startup financial model investors trust. In one weekend.</p>
          <div class="price">
            {%- if code != blank -%}
              <span class="now">{{ launch_cents | money_without_trailing_zeros }}</span><s>{{ v.price | money_without_trailing_zeros }}</s><span class="tag">LAUNCH PRICE</span>
            {%- else -%}
              <span class="now">{{ v.price | money_without_trailing_zeros }}</span>{%- if v.compare_at_price > v.price -%}<s>{{ v.compare_at_price | money_without_trailing_zeros }}</s>{%- endif -%}
            {%- endif -%}
          </div>
          {%- if section.settings.launch_end != blank -%}
          <div class="count" data-end="{{ section.settings.launch_end }}"><div><b data-d>0</b><small>days</small></div><div><b data-h>0</b><small>hrs</small></div><div><b data-m>0</b><small>min</small></div><div><b data-s>0</b><small>sec</small></div></div>
          {%- endif -%}
          <div class="ctas"><a class="btn" href="{{ buy_url }}">Get the guide →</a><a class="ghost" href="#inside">See what's inside</a></div>
          <div class="trust"><span>17-page PDF</span><span>Instant download</span><span>14-day refund</span></div>
        </div>
        <div class="media">{%- if p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 1200 }}" alt="{{ p.featured_image.alt | escape }}" width="1200" height="1200" loading="eager">{%- endif -%}</div>
      </div>
      {%- endif -%}
    </div>
  </div>

  <section class="s">
    <div class="wrap">
      <div class="k">The problem</div>
      <h2>Templates are free. Trust isn't.</h2>
      <p class="lead">You can download a startup model template in 30 seconds. Then you fill it in, the investor asks one question, and the numbers fall apart. These are the mistakes investors notice fastest:</p>
      <div class="g3">
        <div class="card red"><div class="ic">%</div><h3>Growth typed as a %</h3><p>"Revenue grows 20% a month" isn't a driver. Investors read it as a wish.</p></div>
        <div class="card red"><div class="ic">$B</div><h3>"1% of a huge market"</h3><p>It says nothing about how you'll win customer number one.</p></div>
        <div class="card red"><div class="ic">0</div><h3>No cash line</h3><p>Profit isn't cash. Investors want to know the month you run out.</p></div>
      </div>
    </div>
  </section>

  <section class="s" style="background:#fff" id="inside">
    <div class="wrap">
      <div class="k">What's inside</div>
      <h2>8 short chapters. One finished model.</h2>
      <p class="lead">Each chapter is one decision you need to get right, with a worked example you can copy straight into Excel or Google Sheets.</p>
      <div class="ch">
        <div class="card"><div class="n">01</div><h3>The 6 red flags</h3><p>What lowers trust in minutes, and the fix for each.</p></div>
        <div class="card"><div class="n">02</div><h3>The only 4 tabs you need</h3><p>Inputs → revenue → team &amp; costs → cash.</p></div>
        <div class="card"><div class="n">03</div><h3>Bottom-up revenue</h3><p>A funnel you can explain, with a full worked example.</p></div>
        <div class="card"><div class="n">04</div><h3>Unit economics</h3><p>Paid CAC, LTV and payback, done honestly.</p></div>
        <div class="card"><div class="n">05</div><h3>Team &amp; costs</h3><p>The hiring plan that drives most of your burn.</p></div>
        <div class="card"><div class="n">06</div><h3>Cash &amp; the raise</h3><p>Runway, how much to ask for, and use of funds.</p></div>
        <div class="card"><div class="n">07</div><h3>Scenarios</h3><p>Downside, base and upside, switched with one cell.</p></div>
        <div class="card"><div class="n">08</div><h3>Defending it</h3><p>The 10 questions investors ask, and how to answer.</p></div>
      </div>
      <div class="tools"><span>+ Assumption log</span><span>+ Hour-by-hour weekend plan</span><span>+ 15-point pre-send checklist</span><span>+ Plain-English glossary</span></div>
      {%- if p.images.size > 2 -%}
      <div class="shots">
        {%- for img in p.images offset: 2 limit: 4 -%}
          <img src="{{ img | image_url: width: 700 }}" alt="{{ img.alt | escape }}" loading="lazy" width="700" height="990">
        {%- endfor -%}
      </div>
      {%- endif -%}
    </div>
  </section>

  <section class="s">
    <div class="wrap">
      <div class="k">A taste of chapter 3</div>
      <h2>Stop sizing the market. Start sizing the funnel.</h2>
      <div class="vs">
        <div class="card bad"><span class="pill" style="color:var(--r)">Top-down ✕</span><p style="font-size:18px;color:#5a1f15">"The market is $2B. If we capture 1%, that's $20M."</p><p style="color:#5a1f15">Every competitor can write the same sentence.</p></div>
        <div class="card good"><span class="pill" style="color:var(--g)">Bottom-up ✓</span><p style="font-size:18px;color:#0f3d26">"$3,000 in ads → 2,000 visitors → 4% trial → 20% pay $49 a month."</p><p style="color:#0f3d26">Every number can be tested.</p></div>
      </div>
      <table>
        <tr><th>Line</th><th>Driver</th><th style="text-align:right">Value</th></tr>
        <tr><td>Visitors (paid + organic)</td><td>2,000 + 1,000</td><td class="n">3,000</td></tr>
        <tr><td>Trials</td><td>3,000 × 4%</td><td class="n">120</td></tr>
        <tr><td>New paying customers</td><td>120 × 20%</td><td class="n">24</td></tr>
        <tr><td>Churned</td><td>300 × 4%</td><td class="n">−12</td></tr>
        <tr class="t"><td>MRR</td><td>312 customers × $49</td><td class="n">$15,288</td></tr>
      </table>
    </div>
  </section>

  <section class="s" style="background:#fff">
    <div class="wrap">
      <div class="g2" style="margin-top:0">
        <div><div class="k">Who it's for</div><h2>Built for founders, not finance people.</h2>
          <ul class="ck"><li>Pre-seed and seed founders preparing a raise</li><li>You can use Excel or Google Sheets</li><li>You have a template (or a messy sheet) and don't trust it yet</li><li>You want to walk into the meeting with answers ready</li></ul></div>
        <div><div class="k" style="color:var(--r)">Not for</div><h2 style="color:var(--mut)">Skip it if…</h2>
          <ul class="ck x"><li>You need a 100-tab banking model</li><li>You're raising Series B or later with a CFO</li><li>You want a plug-in template with no thinking. This guide teaches the thinking.</li></ul></div>
      </div>
    </div>
  </section>

  <section class="s">
    <div class="wrap author">
      <div class="avatar">MA</div>
      <div><div class="k">Who wrote it</div><h2 style="font-size:34px">Muhammad Ali Asghar</h2>
        <p class="lead" style="margin:0">Financial modeller. Economics and Finance at IBA Karachi, CFA Level I candidate. I've built three-statement valuations, startup DCF models with private-equity waterfalls, and credit and risk models, plus revenue forecasting and receivables work in the finance team at a large energy company. This guide is what I'd tell a founder friend the night before they build their first model.</p></div>
    </div>
  </section>

  <section class="s" style="background:#fff">
    <div class="wrap" style="max-width:820px">
      <div class="k">FAQ</div><h2>Questions</h2>
      <details><summary>What exactly do I get?</summary><p>A 17-page PDF (A4) that downloads right after checkout: 8 chapters, a worked SaaS example, an assumption log, a weekend plan, a 15-point checklist and a glossary.</p></details>
      <details><summary>Is there a spreadsheet template?</summary><p>The guide shows you exactly how to lay out each of the 4 tabs, so you can build the model in your own Excel or Google Sheets, or fix the template you already have. You'll understand every cell, which is what investors test.</p></details>
      <details><summary>My startup isn't SaaS. Does it still work?</summary><p>Yes. The same driver chain works for marketplaces (listings → buyers → orders × take rate), consumer apps and service businesses (leads → calls → deals × contract value). Chapter 3 shows how.</p></details>
      <details><summary>What if it doesn't help me?</summary><p>Email within 14 days of buying and you'll get a full refund. No forms, no arguments.</p></details>
      <details><summary>Can you just build the model for me?</summary><p>Yes. Done-for-you models take about 5 days. Email {{ shop.email }} with your stage and how much you're raising.</p></details>
    </div>
  </section>

  <div class="dark">
    <section class="s final"><div class="wrap">
      <div class="k">Your next investor meeting</div>
      <h2>Walk in with numbers you can defend.</h2>
      <p class="lead" style="margin:0 auto 26px;color:#C9D3E0">One weekend. Four tabs. Ten answers ready before they ask.</p>
      <div class="price">
        {%- if code != blank -%}<span class="now">{{ launch_cents | money_without_trailing_zeros }}</span><s>{{ v.price | money_without_trailing_zeros }}</s>{%- else -%}<span class="now">{{ v.price | money_without_trailing_zeros }}</span>{%- endif -%}
      </div>
      <a class="btn" href="{{ buy_url }}">Get Fundable Numbers →</a>
      <div class="trust" style="justify-content:center"><span>Instant PDF download</span><span>14-day refund</span><span>Secure checkout</span></div>
    </div></section>
    {%- if section.settings.hide_theme_chrome -%}
    <div class="wrap foot">
      <span>© {{ 'now' | date: '%Y' }} Fundable Numbers</span>
      <span>{%- for policy in shop.policies -%}<a href="{{ policy.url }}">{{ policy.title }}</a>{%- endfor -%}<a href="mailto:{{ shop.email }}">Contact</a></span>
    </div>
    {%- endif -%}
  </div>

  <div class="sticky" id="fn-sticky"><span><b>Fundable Numbers</b> · {% if code != blank %}{{ launch_cents | money_without_trailing_zeros }}{% else %}{{ v.price | money_without_trailing_zeros }}{% endif %}</span><a class="btn" href="{{ buy_url }}">Get it →</a></div>
</div>

<script>
  (function(){
    var c=document.querySelector('.fn .count');
    if(c){ var end=new Date(c.dataset.end).getTime();
      function t(){ var d=Math.max(0,end-Date.now()); if(!d){c.style.display='none';return}
        c.querySelector('[data-d]').textContent=Math.floor(d/864e5);
        c.querySelector('[data-h]').textContent=Math.floor(d%864e5/36e5);
        c.querySelector('[data-m]').textContent=Math.floor(d%36e5/6e4);
        c.querySelector('[data-s]').textContent=Math.floor(d%6e4/1e3);}
      t(); setInterval(t,1000); }
    var s=document.getElementById('fn-sticky');
    if(s){ window.addEventListener('scroll',function(){ s.classList.toggle('on', window.scrollY>700) },{passive:true}); }
  })();
</script>

{% schema %}
{
  "name": "Fundable landing",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "discount_code", "label": "Launch discount code", "default": "LAUNCH" },
    { "type": "range", "id": "discount_percent", "label": "Discount %", "min": 0, "max": 90, "step": 5, "default": 35 },
    { "type": "text", "id": "launch_end", "label": "Launch ends (ISO date)", "default": "2026-10-12T18:59:00Z" },
    { "type": "checkbox", "id": "show_hero", "label": "Show hero", "default": true },
    { "type": "checkbox", "id": "hide_theme_chrome", "label": "Hide theme header/footer", "default": true }
  ],
  "presets": [{ "name": "Fundable landing" }]
}
{% endschema %}
